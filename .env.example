# 587 is STARTTLS; implicit TLS on 465 is not supported.
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Bauer as a Service
SMTP_SENDER_EMAIL=
